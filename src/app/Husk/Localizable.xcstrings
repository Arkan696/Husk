    "Install Husk.ipa through TrollStore, on an iOS version TrollStore supports. It carries the entitlements TrollStore keeps, so the same file works there and in a sideloader.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TrollStore 支持的 iOS 版本上，通过 TrollStore 安装 Husk.ipa。它带有 TrollStore 会保留的权限，因此同一个文件既适用于 TrollStore，也适用于侧载工具。"
          }
        }
      }
    },
    "Install [LocalDevVPN](%@) from the App Store.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App Store 安装 [LocalDevVPN](%1$@)。"
