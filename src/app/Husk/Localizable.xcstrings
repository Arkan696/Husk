    "Boot animation running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机动画运行中"
          }
        }
      }
    },
    "Boots the guest as soon as Husk opens, once JIT is available. Off means you start it yourself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 可用时，Husk 一打开就启动安卓客户机。关闭则需你手动启动。"
          }
        }
      }
    },
    "Boots the guest as soon as Husk opens, when JIT is available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 可用时，Husk 一打开就启动安卓客户机。"
          }
        }
      }
    },
    "Both sides must be between 240 and 2560.": {
      "localizations": {
