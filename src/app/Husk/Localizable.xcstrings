            "state": "translated",
            "value": "浏览文件"
          }
        }
      }
    },
    "Browse and download apps using an anonymous Aurora guest account, or sign in with your Google account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用匿名的 Aurora 访客账号浏览和下载应用，也可登录你的 Google 账号。"
          }
        }
      }
